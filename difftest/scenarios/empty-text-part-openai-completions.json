{
  "name": "empty-text-part-openai-completions",
  "note": "Upstream 1b6ddca87 (pi #9797): openai-completions drops empty text parts from array-form user content, so an image-only message carries no {type:\"text\",text:\"\"} part, and a message of only empty text is skipped. Post-dates the 0.87.0 build, so backend is src.",
  "backend": "src",
  "api": "openai-completions",
  "entry": "streamSimple",
  "model": {
    "id": "gpt-4o-mini",
    "name": "GPT-4o mini",
    "api": "openai-completions",
    "provider": "openai",
    "baseUrl": "https://api.openai.com/v1",
    "reasoning": false,
    "input": [
      "text",
      "image"
    ],
    "cost": {
      "input": 0.15,
      "output": 0.6,
      "cacheRead": 0,
      "cacheWrite": 0
    },
    "contextWindow": 128000,
    "maxTokens": 16384
  },
  "context": {
    "systemPrompt": "You are helpful.",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": ""
          },
          {
            "type": "image",
            "data": "ZmFrZQ==",
            "mimeType": "image/png"
          }
        ],
        "timestamp": 1
      },
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": ""
          }
        ],
        "timestamp": 2
      },
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Describe it."
          },
          {
            "type": "text",
            "text": ""
          }
        ],
        "timestamp": 3
      }
    ]
  },
  "options": {
    "apiKey": "test-key"
  }
}
